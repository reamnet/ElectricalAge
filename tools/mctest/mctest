def env_args() -> list:
    """Return a list of KEY=VALUE strings to prepend to any Gradle/Java command."""
    extra = ["JDK25=/home/matthew/jdks/jdk-25.0.5+8",
             "JDK21=/home/matthew/jdks/jdk-21.0.13+9",
             "GRADLE_USER_HOME=/tmp/eln-port-gradle"]
    # respect overrides if already set
    if os.environ.get("JDK25"):
