def cmd_http(args):
    import http.server
    import socketserver
    import threading

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _send(self, code, obj):
            body = json.dumps(obj).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/status":
                print = None
                g = process_group("server")
                c = process_group("client")
                host, port, password = rcon_config()
                live = False
                r = RCON(host, port, password, timeout=2)
                try:
                    r.connect(); r._auth(); live = True
                except Exception:
                    pass
                finally:
                    r.close()
                self._send(200, {"server": g is not None, "server_rcon_live": live,
                                 "client": c is not None})
            elif self.path == "/logs":
                files = sorted(LOGDIR.glob("*.log"))
                self._send(200, {"logs": [str(f.relative_to(REPO)) for f in files]})
            else:
                self._send(404, {"error": "not found"})

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length) if length else b"{}"
            try:
                req = json.loads(raw or b"{}")
            except json.JSONDecodeError:
                req = {}
            action = req.get("action")
            try:
                if action == "exec":
                    self._send(200, {"response": rcon_exec(req.get("command", ""))})
                elif action == "chat":
                    wid = find_minecraft_window()
                    chat_send(wid, req.get("message", ""))
                    self._send(200, {"sent": req.get("message", "")})
                elif action == "screenshot":
                    name = "http-%d.png" % int(time.time())
                    out = REPO / "tools" / "mctest" / "shots" / name
                    try:
                        path = screenshot_window(Path(out))
                    except SystemExit:
                        path = None
                    if not path:
                        try:
                            path = screenshot_in_game(Path(out))
                        except SystemExit:
                            path = None
                    self._send(200 if path else 500, {"screenshot": path})
                elif action == "tail":
                    which = req.get("which", "server")
                    n = int(req.get("n", 100))
                    self._send(200, {"which": which, "tail": tail_log(which, n)})
                else:
                    self._send(400, {"error": "unknown action: %s" % action})
            except SystemExit as e:
                self._send(500, {"error": str(e)})
            except Exception as e:
                self._send(500, {"error": "%s: %s" % (type(e).__name__, e)})

    class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    host = args.bind
    port = args.port
    srv = Server((host, port), Handler)
    print("mctest http control plane on http://%s:%d  (endpoints: GET /status, GET /logs, POST {action:exec|chat|screenshot|tail})" % (host, port))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


