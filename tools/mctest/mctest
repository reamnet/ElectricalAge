        e[k] = v
    e["PATH"] = e.get("JDK25", "/home/matthew/jdks/jdk-25.0.5+8") + "/bin:" + e.get("PATH", "")
    return e


def ensure_state():
    STATE.mkdir(parents=True, exist_ok=True)
    LOGDIR.mkdir(parents=True, exist_ok=True)


def pidfile(name: str) -> Path:
    return STATE / (name + ".pid")


def logpath(name: str) -> Path:
    return LOGDIR / (name + ".log")


def read_pid(name: str):
    p = pidfile(name)
    if not p.exists():
        return None
    try:
        return int(p.read_text().strip())
    except ValueError:
        return None


def write_pid(name: str, pid: int):
    ensure_state()
    pidfile(name).write_text(str(pid))


def clear_pid(name: str):
    pidfile(name).unlink(missing_ok=True)


def pid_alive(pid) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def process_group(name: str):
    """Return (pid, cmdline) of the gradle/java process we launched for this name, if any."""
    pid = read_pid(name)
    if not pid_alive(pid):
        return None
    try:
        cmd = Path("/proc/%d/cmdline" % pid).read_bytes().decode("utf-8", "replace").replace("\0", " ")
    except Exception:
        cmd = "?"
    return (pid, cmd)


# --------------------------------------------------------------------------- #
# Source RCON client (protocol 3), stdlib socket only                          #
# --------------------------------------------------------------------------- #

class RCON:
    def __init__(self, host, port, password, timeout=5.0):
        self.host = host
        self.port = port
        self.password = password
        self.timeout = timeout
        self.sock = None

    @staticmethod
    def _recv_exact(sock, n):
        buf = b""
        while len(buf) < n:
            chunk = sock.recv(n - len(buf))
            if not chunk:
                raise ConnectionError("RCON socket closed")
            buf += chunk
        return buf

    @staticmethod
    def _read_packet(sock):
        length = struct_unpack_i(RCON._recv_exact(sock, 4))
        body = RCON._recv_exact(sock, max(length - 4, 0))
        pkt_type, pkt_id = struct.unpack("<Hi", body[:6])
        payload = body[6:]
        if payload.endswith(b"\x00\x00"):
            payload = payload[:-2]
        elif payload.endswith(b"\x00"):
            payload = payload[:-1]
        return pkt_id, pkt_type, payload.decode("utf-8", "replace")

    @staticmethod
    def _build_packet(pkt_type: int, req_id: int, payload: str) -> bytes:
        data = payload.encode("utf-8") + b"\x00\x00"
        length = 10 + len(data)
        return struct.pack("<iHi", length, pkt_type, req_id) + data

    def connect(self):
        self.sock = socket.create_connection((self.host, self.port), timeout=self.timeout)
        self.sock.settimeout(self.timeout)

    def close(self):
        if self.sock:
            try:
                self.sock.close()
            finally:
                self.sock = None

    def _auth(self):
        # Source RCON: AUTH request type=3. Server replies type=2 with id 0 (OK) or id -1 (fail).
        self._send(self._build_packet(3, 0, self.password))
        pkt_id, _type, _payload = self._read_packet(self.sock)
        if pkt_id == 0:
            return True
        if pkt_id == -1:
            raise PermissionError("RCON auth failed (bad password)")
        raise ConnectionError("RCON auth returned unexpected id %d" % pkt_id)

    def _send(self, packet: bytes):
        self.sock.sendall(packet)

    def _recv_exact2(self, sock, n):
        return self._recv_exact(sock, n)

    def command(self, cmd: str, expect: bool = True) -> str:
        """Send a command and return the concatenated response text (terminating empty packet excluded)."""
        if not self.sock:
            raise ConnectionError("RCON not connected")
        req_id = 0x1234
        self._send(self._build_packet(2, req_id, cmd))
        chunks = []
        deadline = time.time() + self.timeout
        while time.time() < deadline:
            try:
                pkt_id, _type, payload = self._read_packet(self.sock)
            except socket.timeout:
                break
            if pkt_id == req_id and not payload:
                break
            if pkt_id == req_id:
                chunks.append(payload)
        text = "\n".join(chunks)
        if expect and not text:
            # Minecraft RCON often returns an empty body on success; treat empty as OK.
            pass
        return text


def struct_unpack_i(b4):
    import struct as _s
    return _s.unpack("<i", b4)[0]


def rcon_config():
    host = os.environ.get("MCTEST_RCON_HOST", DEFAULT_RCON_HOST)
    port = int(os.environ.get("MCTEST_RCON_PORT", DEFAULT_RCON_PORT))
    password = os.environ.get("MCTEST_RCON_PASSWORD", DEFAULT_RCON_PASSWORD)
    return host, port, password


# --------------------------------------------------------------------------- #
# Process management                                                          #
# --------------------------------------------------------------------------- #

def spawn(name: str, argv: list, cwd: Path, logname: str, extra_env: dict = None) -> int:
    ensure_state()
    logf = open(logpath(logname), "ab")
    env = gradle_env()
    env["DISPLAY"] = DISPLAY
    if extra_env:
        env.update(extra_env)
    proc = subprocess.Popen(argv, cwd=str(cwd), stdout=logf, stderr=subprocess.STDOUT,
                            env=env, start_new_session=True)
    write_pid(name, proc.pid)
    return proc.pid


def stop_process(name: str, grace=8) -> bool:
    """Terminate the process group we launched for name (gradle + child java)."""
    pid = read_pid(name)
    if not pid_alive(pid):
        clear_pid(name)
        return False
    # kill the whole process group (start_new_session gave it its own pgid == pid)
    try:
        os.killpg(pid, signal.SIGTERM)
    except ProcessLookupError:
        clear_pid(name)
        return False
    except PermissionError:
        try:
            os.kill(pid, signal.SIGTERM)
        except Exception:
            pass
    deadline = time.time() + grace
    while time.time() < deadline:
        if not pid_alive(pid):
            break
        time.sleep(0.2)
    if pid_alive(pid):
        try:
            os.killpg(pid, signal.SIGKILL)
        except Exception:
            try:
                os.kill(pid, signal.SIGKILL)
            except Exception:
                pass
    clear_pid(name)
    return True


def wait_for_rcon(host, port, password, timeout=120):
    deadline = time.time() + timeout
    last = None
    while time.time() < deadline:
        r = RCON(host, port, password)
        try:
            r.connect()
            r._auth()
            return True
        except Exception as e:
            last = e
            r.close()
            time.sleep(2)
    raise SystemExit("RCON did not become ready (last error: %s)" % last)


def wait_for_port(host, port, timeout=120):
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            with socket.create_connection((host, port), timeout=1):
                return True
        except OSError:
            time.sleep(1)
    raise SystemExit("server port %s:%d did not open" % (host, port))


# --------------------------------------------------------------------------- #
# servers.dat seeding (26.3 NBT schema, 77 bytes)                              #
# --------------------------------------------------------------------------- #

def make_servers_dat(ip: str, name: str = "Local (mctest)") -> bytes:
    def nbt_string(s):
        b = s.encode("utf-8")
        return struct.pack(">H", len(b)) + b

    def nbt_byte(v):
        return bytes([v])

    # entry compound: name "hidden"(1) byte 0; "ip" string; "name" string
    entry_inner = b""
    entry_inner += nbt_string("hidden") + nbt_byte(0)
    entry_inner += nbt_string("ip") + nbt_string(ip)
    entry_inner += nbt_string("name") + nbt_string(name)
    entry_inner += b"\x00"  # end of compound

    entry = bytes([0x0A]) + struct.pack(">I", len(entry_inner)) + entry_inner  # compound tag
    lst = bytes([0x09]) + struct.pack(">I", 1) + entry                        # list of 1
    lst = nbt_string("servers") + lst
    root = b"" + lst + b"\x00"                                               # root compound (empty name) + end
    return root


def seed_servers(ip: str):
    """Write run/servers.dat (gitignored) with one entry for ip."""
    path = RUNDIR / "servers.dat"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(make_servers_dat(ip))
    return path


