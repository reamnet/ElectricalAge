def cmd_client_start(args):
    if process_group("client"):
        print("client already running:", process_group("client"))
        return 0
    # seed servers.dat with the target address
    ip = args.server_addr
    seed_servers(ip)
    quick = ip  # --quickPlayMultiplayer takes the address string
    spawn("client",
          [str(REPO / "gradlew"), "--no-daemon", "--max-workers=2", "runClient",
           "--args=--quickPlayMultiplayer %s --username %s" % (quick, args.username)],
          REPO, "client")
    print("started dev client (gradle runClient, quick-play to %s); waiting for window..." % quick)
    deadline = time.time() + args.timeout
    wid = None
    while time.time() < deadline:
        try:
            wid = find_minecraft_window(); break
        except SystemExit:
            time.sleep(2)
    if not wid:
        print("warning: Minecraft window not found yet (still loading?)")
    else:
        print("window id:", wid)
    return 0


def cmd_client_stop(_args):
    if not process_group("client"):
        print("client not running"); return 0
    stop_process("client", grace=8)
    print("client stopped"); return 0


def cmd_client_status(_args):
    g = process_group("client")
    try:
        wid = find_minecraft_window()
        geo = window_geometry(wid)
