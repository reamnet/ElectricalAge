    a = cs.add_parser("screenshot"); a.add_argument("name", nargs="?"); a.add_argument("--mode", choices=["in-game", "window", "auto"], default="auto"); a.add_argument("--outdir", default=None); a.set_defaults(fn=cmd_client_screenshot)
