def cmd_doctor(_args):
    report = {"ok": True, "checks": []}
    def check(name, ok, detail="", hard=True):
        report["checks"].append({"name": name, "ok": bool(ok), "detail": detail, "hard": hard})
        if not ok and hard:
            report["ok"] = False

    # JDKs
    j25 = os.environ.get("JDK25", "/home/matthew/jdks/jdk-25.0.5+8")
    j21 = os.environ.get("JDK21", "/home/matthew/jdks/jdk-21.0.13+9")
    check("JDK25", Path(j25, "bin", "java").exists(), j25)
    check("JDK21", Path(j21, "bin", "java").exists(), j21)
    check("gradlew", (REPO / "gradlew").is_file(), str(REPO / "gradlew"))
    check("python3", shutil.which("python3") is not None, shutil.which("python3") or "")
    # display tools
    check("DISPLAY", bool(os.environ.get("DISPLAY", DISPLAY)), os.environ.get("DISPLAY", DISPLAY))
    check("xdotool", shutil.which("xdotool") is not None, shutil.which("xdotool") or "not found")
    check("scrot", shutil.which("scrot") is not None, shutil.which("scrot") or "not found")
    # RCON server properties
    sp = RUNDIR / "server.properties"
    props = {}
    if sp.exists():
        for line in sp.read_text().splitlines():
            if "=" in line and not line.startswith("#"):
                k, v = line.split("=", 1)
                props[k.strip()] = v.strip()
    check("rcon enabled", props.get("enable-rcon") == "true", props.get("enable-rcon", "unset"))
    check("rcon port", props.get("rcon.port", "") == str(DEFAULT_RCON_PORT), props.get("rcon.port", "unset"))
    check("server port", props.get("server-port", "") == "26035", props.get("server-port", "unset"))
    check("online-mode off", props.get("online-mode") == "false", props.get("online-mode", "unset"))
    # jar
    jar = REPO / "build" / "libs" / "eln-26.3-0.1.0-port.jar"
    check("built jar", jar.exists(), str(jar))
    # live server?
    host, port, password = rcon_config()
    r = RCON(host, port, password, timeout=2)
    rcon_live = False
    try:
        r.connect(); r._auth(); rcon_live = True
    except Exception as e:
        rcon_live = False
    finally:
        r.close()
    check("server RCON live", rcon_live, "reachable" if rcon_live else "not running", hard=False)
    # client window?
    try:
        wid = find_minecraft_window()
        check("minecraft window", True, wid, hard=False)
    except SystemExit:
        check("minecraft window", False, "not running", hard=False)
    # Xvfb availability (documented non-replicable)
    xvfb = shutil.which("Xvfb") is not None
    ro = False
    try:
        os.makedirs("/tmp/.X11-unix/_mctest_probe", exist_ok=True)
        os.rmdir("/tmp/.X11-unix/_mctest_probe")
    except (OSError, PermissionError):
        ro = True
    check("Xvfb headless (Xvfb present)", xvfb, "not usable in this container (read-only /tmp/.X11-unix)" if ro else "", hard=False)
    print(json.dumps(report, indent=2))
    return 0 if report["ok"] else 1


