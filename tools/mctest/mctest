def tail_log(which: str, n: int):
    path = logpath(which)
    if not path.exists():
        return "(no %s log at %s)" % (which, path)
    lines = path.read_text(errors="replace").splitlines()
    return "\n".join(lines[-n:])


def cmd_logs(args):
    which = args.which
    path = logpath(which)
    if args.command == "list":
        files = sorted(LOGDIR.glob("*.log"), key=lambda p: p.stat().st_mtime, reverse=True)
        for f in files:
            print("%d  %s" % (f.stat().st_size, f))
        return 0
    if not path.exists():
        print("no log for %s (run it first)" % which)
        # offer alternatives
        alts = [p.name for p in LOGDIR.glob("*.log")]
        if alts:
            print("available:", ", ".join(alts))
        return 1
    text = path.read_text(errors="replace")
    mode = args.command
    if mode == "errors" or args.errors:
        import re as _re
        lines = [l for l in text.splitlines()
                 if _re.search(r"(?i)(error|exception|fail|fatal|stack trace|traceback)", l)]
        text = "\n".join(lines[-(args.tail or 200):])
    elif mode == "grep" and args.grep:
        pat = args.grep
        lines = [l for l in text.splitlines() if pat in l]
        text = "\n".join(lines[-(args.tail or 200):])
    else:
        text = "\n".join(text.splitlines()[-(args.tail or 100):])
    print(text)
    return 0


