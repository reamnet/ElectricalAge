    time.sleep(0.1)
    run_cmd(["xdotool", "click", str(args.button)])
    print("clicked at window-relative (%s,%s) button %s" % (args.x, args.y, args.button))
    return 0


def cmd_client_screenshot(args):
    name = args.name or ("shot-%d" % int(time.time()))
    if not name.lower().endswith(".png"):
        name += ".png"
    out = Path(args.outdir) / name if args.outdir else (REPO / "tools" / "mctest" / "shots" / name)
    if args.mode == "in-game":
        path = screenshot_in_game(Path(out))
    elif args.mode == "window":
        path = screenshot_window(Path(out))
    else:
        path = screenshot_window(Path(out))
        if not path:
