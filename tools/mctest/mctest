    a = cs.add_parser("start"); a.add_argument("--server-addr", default=DEFAULT_SERVER_ADDR); a.add_argument("--username", default="mctest"); a.add_argument("--timeout", type=int, default=180); a.set_defaults(fn=cmd_client_start)
