    ms = m.add_subparsers(dest="sub", required=True)
    a = ms.add_parser("run"); a.add_argument("--case", default=None); a.add_argument("--bench", default=None); a.add_argument("--label", default=None); a.add_argument("--convert", action="store_true"); a.add_argument("--no-rth", action="store_true"); a.add_argument("--timeout", type=int, default=3600); a.set_defaults(fn=cmd_sim_run)

    g = sub.add_parser("logs", help="inspect logs")
    g.add_argument("command", choices=["tail", "grep", "errors", "list"])
    g.add_argument("--which", default="server")
    g.add_argument("--tail", type=int, default=100)
