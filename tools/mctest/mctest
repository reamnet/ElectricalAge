def cmd_server_start(args):
    if process_group("server"):
        print("server already running:", process_group("server"))
        return 0
    seed_servers(args.server_addr.split(":")[0])
    spawn("server", [str(REPO / "gradlew"), "--no-daemon", "--max-workers=2", "runServer"], REPO, "server")
    print("started dev server (gradle runServer); waiting for port + RCON...")
    host, port, password = rcon_config()
    wait_for_port(host, args.rcon_port, timeout=args.timeout)
    wait_for_rcon(host, args.rcon_port, password, timeout=args.timeout)
    print("server ready on %s:%d (RCON %s:%d)" % (host, args.server_port, host, args.rcon_port))
    return 0


def cmd_server_stop(args):
    if not process_group("server"):
        print("server not running")
        return 0
    stop_process("server", grace=args.grace if hasattr(args, "grace") else 8)
    print("server stopped")
    return 0


def cmd_server_status(_args):
    g = process_group("server")
    host, port, password = rcon_config()
    rcon_live = False
    r = RCON(host, port, password, timeout=2)
    try:
        r.connect(); r._auth(); rcon_live = True
    except Exception:
        rcon_live = False
    finally:
        r.close()
    state = {"running": g is not None, "rcon_live": rcon_live, "process": g,
             "log": str(logpath("server"))}
    print(json.dumps(state, indent=2))
    return 0


def cmd_server_exec(args):
    text = rcon_exec(args.command)
    if args.json:
        print(json.dumps({"command": args.command, "response": text}))
    else:
        print(text)
    return 0


