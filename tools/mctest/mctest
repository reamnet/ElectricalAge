def gradle(args: list, cwd: Path = REPO, timeout=3600, logname: str = None) -> subprocess.CompletedProcess:
    argv = [str(REPO / "gradlew"), "--no-daemon", "--max-workers=2", *args]
    env = gradle_env()
    env["DISPLAY"] = DISPLAY
    ensure_state()
    if logname is None:
        logname = "gradle-%d" % int(time.time())
    logf = open(LOGDIR / (logname + ".log"), "ab")
    proc = subprocess.run(argv, cwd=str(cwd), stdout=logf, stderr=subprocess.STDOUT, env=env, timeout=timeout)
    return proc


# --------------------------------------------------------------------------- #
# RCON exec helper                                                            #
# --------------------------------------------------------------------------- #

def rcon_exec(cmd: str, timeout=8):
    host, port, password = rcon_config()
    r = RCON(host, port, password, timeout=timeout)
    r.connect()
    r._auth()
    try:
        return r.command(cmd, expect=False)
    finally:
        r.close()


