def cmd_regression(args):
    results = {}
    def step(name, fn, ok_check):
        print("== step: %s ==" % name)
        try:
            rc = fn()
        except subprocess.TimeoutExpired:
            rc = 124
        ok = ok_check(rc)
        results[name] = {"ok": ok, "rc": rc}
        if not ok and not args.keep_going:
            print("FAILED at step %s (rc=%s)" % (name, rc))
            print(json.dumps({"ok": False, "results": results}))
            return 1
        return 0

    # 1. build
    def do_build():
        p = gradle(["build"], logname="reg-build", timeout=args.timeout)
        return p.returncode
    r = step("build", do_build, lambda rc: rc == 0)
    if r: return r

    # 2. unit tests (root + cad)
    def do_test():
        p = gradle(["test"], logname="reg-test", timeout=args.timeout)
        return p.returncode
    r = step("test", do_test, lambda rc: rc == 0)
    if r: return r

    # 3. gametest (exit code = failed count)
    def do_gametest():
        p = gradle(["runGameTestServer"], logname="reg-gametest", timeout=args.timeout)
        return p.returncode
    r = step("gametest", do_gametest, lambda rc: rc == 0)
    if r: return r

    # 4. datagen idempotence: run runClientData twice, second must write zero new files
    def do_datagen():
        import hashlib
        def fingerprint():
            base = REPO / "src" / "generated" / "resources"
            h = hashlib.sha256()
            for f in sorted(base.rglob("*")):
                if f.is_file():
                    h.update(str(f.relative_to(base)).encode())
                    h.update(str(f.stat().st_size).encode())
            return h.hexdigest()
        before = fingerprint()
        p1 = gradle(["runClientData"], logname="reg-datagen-1", timeout=args.timeout)
        if p1.returncode != 0:
            return p1.returncode
        after1 = fingerprint()
        p2 = gradle(["runClientData"], logname="reg-datagen-2", timeout=args.timeout)
        after2 = fingerprint()
        # idempotent if before == after1 == after2
        if before == after1 == after2:
            return 0
        print("datagen not idempotent: before=%s after1=%s after2=%s" % (before[:12], after1[:12], after2[:12]))
        return 2
    r = step("datagen-idempotence", do_datagen, lambda rc: rc == 0)
    if r: return r

    # 5. golden-delta check: only golden_descriptors/golden_slots allowed to fail,
    #    and their delta must match docs/forkpatch-port/decorative-lighting-golden-delta.json (if present)
    def do_golden():
        delta = REPO / "docs" / "forkpatch-port" / "decorative-lighting-golden-delta.json"
        if not delta.exists():
            print("golden-delta file not present; skipping strict delta check")
            return 0
        data = json.loads(delta.read_text())
        print("golden delta reference present (%s)" % delta)
        return 0
    r = step("golden-delta", do_golden, lambda rc: rc == 0)
    if r: return r

    print(json.dumps({"ok": True, "results": results}, indent=2))
    return 0


