def run_cmd(argv, timeout=20):
    return subprocess.run(argv, capture_output=True, text=True, timeout=timeout)


def find_minecraft_window() -> str:
    # search by class and name
    r = run_cmd(["xdotool", "search", "--name", "Minecraft"])
    wins = r.stdout.split()
    for w in wins:
        return w
    r = run_cmd(["xdotool", "search", "--class", "minecraft"])
    wins = r.stdout.split()
    if wins:
        return wins[0]
    # generic: any window with "Minecraft" in the name (case-insensitive)
    r = run_cmd(["xdotool", "search", "--name", "Minecraft"])
    wins = r.stdout.split()
    if wins:
        return wins[0]
    raise SystemExit("no Minecraft window found on %s" % DISPLAY)


def window_geometry(wid) -> dict:
    r = run_cmd(["xdotool", "getwindowgeometry", wid])
    txt = r.stdout
    def grab(pat):
        m = re.search(pat, txt)
        return int(m.group(1)) if m else 0
    return {
        "id": wid,
        "x": grab(r"Position:\s*(\d+)"),
        "y": grab(r"Position:\s*\d+,\s*(\d+)"),
        "width": grab(r"Geometry:\s*(\d+)"),
        "height": grab(r"Geometry:\s*\d+x(\d+)"),
    }


def focus_window(wid):
    run_cmd(["xdotool", "windowactivate", wid])
    run_cmd(["xdotool", "windowraise", wid])
    time.sleep(0.4)


def click_at_center(wid):
    g = window_geometry(wid)
    cx = g["x"] + g["width"] // 2
    cy = g["y"] + g["height"] // 2
    run_cmd(["xdotool", "mousemove", str(cx), str(cy)])
    run_cmd(["xdotool", "click", "1"])


def screenshot_in_game(out_path: Path):
    """Send F2 to the client, wait for the file in run/screenshots, copy to out_path."""
    try:
        wid = find_minecraft_window()
        focus_window(wid)
    except SystemExit:
        wid = None
        focus_window(wid) if wid else None
    # F2 to save
    if wid:
        run_cmd(["xdotool", "key", "--window", wid, "F2"])
    else:
        run_cmd(["xdotool", "key", "F2"])
    shots = RUNDIR / "screenshots"
    deadline = time.time() + 8
    newest = None
    while time.time() < deadline:
        if shots.is_dir():
            files = sorted(shots.glob("*.png"), key=lambda p: p.stat().st_mtime)
            if files:
                cand = files[-1]
                if newest and cand == newest and (time.time() - cand.stat().st_mtime) > 3:
                    break
                newest = cand
                # small settle
                time.sleep(0.5)
        else:
            time.sleep(0.3)
    if newest and newest.exists():
        out_path.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(newest, out_path)
        return str(out_path)
    raise SystemExit("in-game screenshot not found in run/screenshots (window may not be in world)")


def screenshot_window(out_path: Path):
    wid = find_minecraft_window()
    g = window_geometry(wid)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    # Prefer a window-scoped capture via scrot's autoselect region (-a X,Y,W,H) so
    # regression screenshots track the game window rather than the whole desktop.
    x = int(g.get("x", 0) or 0); y = int(g.get("y", 0) or 0)
    w = int(g.get("width", 0) or 0); h = int(g.get("height", 0) or 0)
    if w > 0 and h > 0:
        subprocess.run(["scrot", "-z", "-a", "%d,%d,%d,%d" % (x, y, w, h), str(out_path)],
                       capture_output=True, text=True)
    if not out_path.exists():
        # fallback: whole screen
        subprocess.run(["scrot", "-z", str(out_path)], capture_output=True, text=True)
    return str(out_path) if out_path.exists() else None


def chat_send(wid, message: str):
    focus_window(wid)
    run_cmd(["xdotool", "key", "--window", wid, "t"])
    time.sleep(0.25)
    run_cmd(["xdotool", "type", "--window", wid, "--delay", "20", message])
    time.sleep(0.2)
    run_cmd(["xdotool", "key", "--window", wid, "Return"])


