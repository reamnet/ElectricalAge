    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    if args.repo:
        global REPO, STATE, LOGDIR, RUNDIR
        REPO = Path(args.repo).resolve()
        STATE = REPO / "tools" / "mctest" / ".state"
        LOGDIR = STATE / "logs"
        RUNDIR = REPO / "run"
    ensure_state()
    try:
        return args.fn(args)
    except SystemExit as e:
        print("error:", e, file=sys.stderr)
        return 1
    except subprocess.TimeoutExpired as e:
        print("timeout:", e, file=sys.stderr)
        return 124
    except PermissionError as e:
        print("permission:", e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
