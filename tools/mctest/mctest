    if os.environ.get("JDK21"):
        extra = [e for e in extra if not e.startswith("JDK21=")]
    if os.environ.get("GRADLE_USER_HOME"):
        extra = [e for e in extra if not e.startswith("GRADLE_USER_HOME=")]
